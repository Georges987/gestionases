# =============================================================================
# Configuration de déploiement FTP pour Gestion ONG (SQLite)
# =============================================================================
# Renseignez vos identifiants OVH ci-dessous
# NE PAS COMMITER CE FICHIER (ajoutez-le à .gitignore)
# =============================================================================

# Serveur FTP OVH
FTP_HOST=ftp.cluster027.hosting.ovh.net

# Identifiants FTP (fournis par OVH)
FTP_USER=votre-identifiant-ftp
FTP_PASS=votre-mot-de-passe-ftp

# Chemin distant sur le serveur (généralement /www pour OVH)
FTP_REMOTE_PATH=/www

# URL de l'API (pour le frontend)
VITE_API_BASE=/admin/api
