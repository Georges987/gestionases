# =============================================================================
# Gestion ONG — configuration Docker (PostgreSQL externe)
# Copier ce fichier vers .env (à la racine du projet) puis éditer les valeurs
#   copy .env.docker.example .env
# =============================================================================

# ---------- Driver (postgres | sqlite) ----------
# postgres = base externe (hébergée) ; sqlite = fichiers embarqués (dev local)
DB_DRIVER=postgres

# ---------- Connexion Postgres externe (obligatoire si DB_DRIVER=postgres) ----------
DB_HOST=votre-hote-postgres.exemple.com
DB_PORT=5432
DB_NAME=gestion_ong
DB_USER=gestion_user
DB_PASSWORD=changez-moi
# Mode SSL : require (obligatoire pour la plupart des hébergeurs), prefer, disable
DB_SSLMODE=require

# ---------- Option SQLite (uniquement si DB_DRIVER=sqlite) ----------
# DB_PATH=/var/www/data/users.db
# GESTION_DB_PATH=/var/www/data/gestion.db

# ---------- Authentification (obligatoire) ----------
# Générez une clé forte : openssl rand -hex 32   ou   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=changez-moi-avec-une-cle-longue-et-aleatoire
JWT_EXPIRY=86400

# Compte admin créé uniquement à la première connexion si absent
ADMIN_EMAIL=admin@gestion-ong.org
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=changez-moi-mot-de-passe

# ---------- Réseau / CORS ----------
# Domaine autorisé à appeler l'API (en Docker local : http://localhost:3030)
ALLOWED_ORIGIN=http://localhost:3030

# ---------- Frontend (build-time) ----------
VITE_API_BASE=/admin/api

# ---------- Migration SQLite → PostgreSQL (outil) ----------
# SQLITE_USERS_DB=./api/data/users.db
# SQLITE_GESTION_DB=./api/data/gestion.db
